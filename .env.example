# Copy this file to .env and fill it in.

# --- Server ---
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from your network (the app has no login).
HOST=127.0.0.1
KEEP_DAYS=7
REFRESH_HOURS=3

# --- Daily email digest ---
# With Gmail: enable 2-step verification and create an "app password" at
# https://myaccount.google.com/apppasswords (use that, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender (defaults to SMTP_USER) and recipient of the digest.
MAIL_FROM=
MAIL_TO=
# Local hour from which the digest is sent each day (0-23).
DIGEST_HOUR=8
# App address used in the email links.
PUBLIC_URL=http://localhost:3000
